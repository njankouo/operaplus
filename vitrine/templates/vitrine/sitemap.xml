<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">{% with b=request.scheme|add:"://"|add:request.get_host %}
  <url><loc>{{ b }}/</loc><changefreq>weekly</changefreq><priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="fr" href="{{ b }}/"/><xhtml:link rel="alternate" hreflang="en" href="{{ b }}/en/"/></url>
  <url><loc>{{ b }}/en/</loc><changefreq>monthly</changefreq><priority>0.8</priority>
    <xhtml:link rel="alternate" hreflang="fr" href="{{ b }}/"/><xhtml:link rel="alternate" hreflang="en" href="{{ b }}/en/"/></url>
  <url><loc>{{ b }}/packages/</loc><changefreq>monthly</changefreq><priority>0.9</priority></url>
  <url><loc>{{ b }}/demos/</loc><changefreq>monthly</changefreq><priority>0.8</priority></url>
  <url><loc>{{ b }}/a-propos/</loc><changefreq>monthly</changefreq><priority>0.7</priority></url>
  <url><loc>{{ b }}/annonces/</loc><changefreq>weekly</changefreq><priority>0.6</priority></url>
{% for f in fonctionnalites %}  <url><loc>{{ b }}/fonctionnalites/{{ f.slug }}/</loc><changefreq>monthly</changefreq><priority>0.8</priority></url>
{% endfor %}  <url><loc>{{ b }}/securite/</loc><changefreq>yearly</changefreq><priority>0.5</priority></url>
  <url><loc>{{ b }}/mentions-legales/</loc><changefreq>yearly</changefreq><priority>0.2</priority></url>
  <url><loc>{{ b }}/confidentialite/</loc><changefreq>yearly</changefreq><priority>0.2</priority></url>
{% endwith %}</urlset>
